# 复制为 .env 后填写，由后端进程读取。.env 不进代码仓库（本仓库是公开的）。

# 必填：数据库连接串。密码只用字母和数字，避免特殊字符破坏连接串
DATABASE_URL=postgresql+asyncpg://<用户>:<密码>@127.0.0.1:<端口>/<库名>

# 必填：Redis 连接串
REDIS_URL=redis://127.0.0.1:<端口>/0

# 必填：登录凭证的签名密钥，用 openssl rand -hex 32 生成。更换后所有人需重新登录
SECRET_KEY=

# 必填：模型服务地址（OpenAI 兼容，以 /v1 结尾）
LLM_BASE_URL=
# 必填：存放模型密钥的文件的绝对路径（只填路径，不要填密钥内容），后端进程需有读权限
LLM_API_KEY_FILE=
# 留空则自动取模型服务返回的第一个模型名
LLM_MODEL=
# 同时发给模型的请求数上限，超出的排队
LLM_MAX_CONCURRENCY=200
