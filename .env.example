# 复制为 .env 后填写。.env 不进代码仓库，也不打进上传包。

# 必填：数据库密码，自行生成一个随机串
POSTGRES_PASSWORD=

# 对外端口
WEB_PORT=8080

# 必填：模型服务地址（OpenAI 兼容，以 /v1 结尾），例如 http://<模型服务IP>:<端口>/v1
LLM_BASE_URL=
# 必填：服务器上存放模型密钥的文件的绝对路径（只填路径，不要填密钥内容）
LLM_API_KEY_FILE=
# 留空则自动取模型服务返回的第一个模型名
LLM_MODEL=
LLM_MAX_CONCURRENCY=200

# 可选：构建时使用的国内镜像，例如
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# NPM_REGISTRY=https://registry.npmmirror.com
PIP_INDEX_URL=
NPM_REGISTRY=
