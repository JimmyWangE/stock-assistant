[Unit]
Description=Stock Assistant web frontend
After=network.target stock-assistant-backend.service
Wants=stock-assistant-backend.service

[Service]
Type=simple
User=nginx
Group=nginx
RuntimeDirectory=stock-assistant-nginx
RuntimeDirectoryMode=0750
# 对外端口小于 1024（如 189）时，非 root 账户需要这项能力才能监听；端口不小于 1024 时可以去掉这两行
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ExecStartPre=/usr/sbin/nginx -e stderr -t -c /etc/stock-assistant/nginx.conf
ExecStart=/usr/sbin/nginx -e stderr -c /etc/stock-assistant/nginx.conf -g "daemon off;"
ExecReload=/usr/sbin/nginx -e stderr -c /etc/stock-assistant/nginx.conf -s reload
KillSignal=SIGQUIT
TimeoutStopSec=30
Restart=on-failure
ReadWritePaths=/run/stock-assistant-nginx /var/log/stock-assistant

[Install]
WantedBy=multi-user.target
